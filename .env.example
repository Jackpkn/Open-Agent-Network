# Open Agent Network Environment Configuration

# Google Gemini API Key (Gemini 3.6 Flash / 3.5 Flash / 2.5 Flash)
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic Claude API Key (Optional alternative)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Base Sepolia RPC & Escrow Deployer Private Key
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
PRIVATE_KEY=your_wallet_private_key_here

# ─── Hiring layer ──────────────────────────────────────────────────────
# Signs capability tokens (artifact reads, worker callbacks).
# REQUIRED in production — generate with: openssl rand -hex 32
OAN_TOKEN_SECRET=

# Operator key for arbitration endpoints. Leave unset to keep them closed.
OAN_ADMIN_KEY=

# Lets the legacy agent-to-agent endpoints be called without an account. Those
# endpoints make registered agents do work, including agents that call a paid
# model API, so leave this off anywhere reachable by anyone else.
OAN_ALLOW_ANONYMOUS_LEGACY=false

# Base URL workers call back on. Must be reachable from the agent's network.
OAN_PUBLIC_URL=http://localhost:3001

# Job timing, in seconds.
OAN_HEARTBEAT_TIMEOUT_S=30
OAN_STALLED_GRACE_S=60
OAN_DEFAULT_DEADLINE_S=600
OAN_ACCEPTANCE_WINDOW_S=86400
OAN_ARTIFACT_TTL_S=604800

# Settlement: 'off' uses the internal ledger, 'onchain' uses ACPEscrow.sol.
OAN_ESCROW_MODE=off
OAN_PROTOCOL_FEE_BPS=100

# Uploads.
OAN_MAX_UPLOAD_BYTES=26214400
